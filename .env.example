# Production / LAN template. Copy to .env and replace every placeholder.
# The application refuses to start in production with these placeholder values.
# Do not commit the copied .env file.

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Host directory mounted at /data in Compose. Keep it private to the service account.
DATA_DIR=./data
DATABASE_URL=sqlite:////data/ai_novel_writer.db

# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_SECRET=replace-with-a-long-random-secret

# Leave the plaintext empty in production. Generate a hash with:
#   cd backend && python -m app.cli.hash_password
APP_ACCESS_PASSWORD=
APP_ACCESS_PASSWORD_HASH=replace-with-a-pbkdf2-hash

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

# Include localhost so the container health check can call 127.0.0.1.
# Add the LAN host browsers will use, without a scheme.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20

# Browser origin, including scheme and port. Do not use *.
CORS_ORIGINS=http://192.168.1.20:8080

LOG_LEVEL=INFO
PUBLISH_PORT=8080
