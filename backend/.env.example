# Copy to backend/.env. Local pages do not require a model API key.
# Development can issue a session when APP_ACCESS_PASSWORD is empty.
# A placeholder APP_AUTH_SECRET makes development write data/dev-auth-secret.
# Set APP_ACCESS_PASSWORD when this machine should ask for a passphrase.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Relative SQLite paths are resolved from the backend working directory.
# When DATABASE_URL is unset, the app uses <repo>/data/ai_novel_writer.db.
DATABASE_URL=sqlite:///../data/ai_novel_writer.db
DATA_DIR=../data

# Leave both empty on 127.0.0.1 development to open the library without a passphrase.
# If APP_ACCESS_PASSWORD_HASH is set, it is the credential and the plaintext is ignored.
# Production must set a hash from: python -m app.cli.hash_password
APP_ACCESS_PASSWORD=
APP_ACCESS_PASSWORD_HASH=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_SECRET=replace-with-a-long-random-secret

# Required in every environment. The process exits if this is missing or not a Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store a copy outside the database. Losing it makes saved model secrets unreadable.
APP_SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional. Comma-separated hosts allowed to bypass the private-network block, for a local model.
MODEL_BASE_URL_ALLOWLIST=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://127.0.0.1:43117,http://localhost:43117
LOG_LEVEL=INFO

# Optional directory of a built frontend. Empty keeps the API-only dev server.
FRONTEND_DIST=
